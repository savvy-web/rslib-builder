{
	"$schema": "https://turborepo.com/schema.v2.json",
	"envMode": "strict",
	"globalPassThroughEnv": ["RSLIB_BUILDER_LOCAL_PATH", "CI", "GITHUB_ACTIONS"],
	"tasks": {
		"build:dev": {
			"cache": true,
			"dependsOn": ["types:check"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"package.json",
				"rslib.config.ts",
				"tsconfig.json",
				"src/**/*.ts",
				"README.md",
				"LICENSE"
			],
			"outputLogs": "errors-only",
			"outputs": ["dist/dev/**", ".rslib/declarations/dev/**"]
		},
		"build:prod": {
			"cache": true,
			"dependsOn": ["types:check"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"package.json",
				"rslib.config.ts",
				"tsconfig.json",
				"src/**/*.ts",
				"README.md",
				"LICENSE"
			],
			"outputLogs": "full",
			"outputs": ["dist/npm/**", ".rslib/declarations/npm/**"]
		},
		"types:check": {
			"cache": true,
			"dependsOn": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"package.json",
				"*.ts",
				"*.mts",
				"*.cts",
				"tsconfig.json",
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"lib/**/*.ts",
				"lib/**/*.tsx",
				"lib/**/*.mts",
				"lib/**/*.cts",
				"types/**/*.ts",
				"__test__/**/*.ts",
				"__test__/**/*.tsx",
				"__test__/**/*.mts",
				"__test__/**/*.cts"
			],
			"outputLogs": "full"
		},
		"vitest:all": {
			"cache": false,
			"dependsOn": ["types:check", "build:dev"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"package.json",
				"*.ts",
				"tsconfig.json",
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"__test__/**/*.ts",
				"__test__/**/*.tsx",
				"__test__/**/*.mts",
				"__test__/**/*.cts"
			],
			"outputs": []
		},
		"vitest:e2e": {
			"cache": false,
			"dependsOn": ["types:check", "build:dev"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"package.json",
				"*.ts",
				"tsconfig.json",
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"__test__/**/*.ts",
				"__test__/**/*.tsx",
				"__test__/**/*.mts",
				"__test__/**/*.cts"
			],
			"outputs": []
		},
		"vitest:unit": {
			"cache": false,
			"dependsOn": ["types:check", "build:dev"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"package.json",
				"*.ts",
				"tsconfig.json",
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"__test__/**/*.ts",
				"__test__/**/*.tsx",
				"__test__/**/*.mts",
				"__test__/**/*.cts"
			],
			"outputs": []
		}
	}
}
