{
	"name": "rslib-builder",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for @savvy-web/rslib-builder and related packages",
	"homepage": "https://github.com/savvy-web/rslib-builder",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/rslib-builder.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build:dev build:prod  --log-order=grouped --log-prefix=none",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" vitest run --coverage",
		"ci:version": "savvy changeset version && biome format --write .",
		"dev": "turbo run dev --filter=@rspress/site --ui=tui",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"preview": "turbo run preview --filter=@rspress/site --ui=tui",
		"reset": "node --experimental-strip-types --experimental-transform-types lib/scripts/hard-reset.ts",
		"test": "vitest run",
		"test:ai": "vitest run --reporter=dot",
		"test:e2e": "turbo run vitest:e2e --log-prefix=none --log-order=grouped",
		"test:unit": "turbo run vitest:unit --log-prefix=none --log-order=grouped",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"vitest:e2e": "vitest run --config vitest.e2e.config.ts --coverage",
		"vitest:unit": "vitest run --coverage"
	},
	"devDependencies": {
		"@savvy-web/silk": "^0.3.1",
		"@savvy-web/vitest": "^1.4.0"
	},
	"packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
	"engines": {
		"node": ">=24.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.3.0",
				"onFail": "ignore"
			}
		]
	}
}
