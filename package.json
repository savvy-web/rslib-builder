{
	"name": "rslib-builder-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for @savvy-web/rslib-builder and related packages",
	"homepage": "https://github.com/savvy-web/rslib-builder",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/rslib-builder.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build --filter='./package' --filter='./examples/**' --log-order=grouped",
		"ci:build": "CI=\"true\" turbo run build --filter='./package' --filter='./examples/**' --log-order=grouped --output-logs=full",
		"ci:test": "CI=\"true\" vitest run --coverage",
		"ci:version": "savvy-changesets version && biome format --write .",
		"commit:check": "savvy-commit check",
		"commit:init": "savvy-commit init",
		"dev": "turbo run dev --filter=rspress-plugin-site",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 '**/*.{md,mdx}' --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"preview": "turbo run preview --filter=rspress-plugin-site",
		"reset": "node --experimental-strip-types --experimental-transform-types lib/scripts/hard-reset.ts",
		"test": "vitest run",
		"test:ai": "vitest run --reporter=dot",
		"test:e2e": "turbo run vitest:e2e --log-prefix=none --log-order=grouped",
		"test:unit": "turbo run vitest:unit --log-prefix=none --log-order=grouped",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"vitest:e2e": "vitest run --config vitest.e2e.config.ts --coverage",
		"vitest:unit": "vitest run --coverage"
	},
	"devDependencies": {
		"@savvy-web/changesets": "^0.7.0",
		"@savvy-web/commitlint": "^0.4.3",
		"@savvy-web/lint-staged": "^0.6.3",
		"@savvy-web/vitest": "^1.0.1"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"engines": {
		"node": ">=24.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.33.0",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "24.11.0",
				"onFail": "ignore"
			}
		]
	}
}
