{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"exactOptionalPropertyTypes": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "ES2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"target": "es2023"
	},
	"exclude": ["node_modules", "dist", ".rspress", ".rslib"],
	"include": ["*.ts", "*.mts", "*.cts", "**/*.tsx", "docs/**/*.mdx"]
}
