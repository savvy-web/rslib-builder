{
	"name": "@libraries/single-entry",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build:dev": "rslib build --env-mode dev",
		"build:meta": "echo 'No meta build step defined'",
		"build:prod": "rslib build --env-mode npm",
		"types:check": "tsgo --noEmit"
	},
	"devDependencies": {
		"@savvy-web/rslib-builder": "workspace:*",
		"@types/node": "catalog:silk",
		"@typescript/native-preview": "catalog:silk",
		"typescript": "catalog:silk"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev",
		"linkDirectory": true,
		"targets": [
			{
				"protocol": "npm",
				"registry": "https://npm.pkg.github.com/",
				"directory": "dist/github",
				"access": "public",
				"provenance": true
			},
			{
				"protocol": "npm",
				"registry": "https://registry.npmjs.org/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			}
		]
	}
}
